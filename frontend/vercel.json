{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://booking-ixsa.onrender.com/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
